    "design-brief:CHR-001:base": {
      "sha256": "ea5da742f3a6dca2ac196867fe958bae2f8be3f55a3db7001a44f67ba6402cf8",
      "content": {
        "schema_version": "DesignDirectionBriefV1",
        "asset_domain": "character",
        "character_id": "CHR-001",
        "draft_character_id": "DRAFT-LINCHE",
        "variant_id": "base",
        "context_sha256": "5fb41135529dba381302d9de1670f3db6f94912baacf9bef340922f6b24bb23a",
        "understanding": {
          "role_in_story": "让冷硬与冷漠的等号失效；反转来自行动与信息差，而非外貌揭底。",
          "core_motivation": "推荐解释：保护具体的人，同时避免援助被转换为人情债与公开表演。",
          "central_tension": "公开以规程和拒绝划界，私下投入有限资源；规程与生命冲突时，选择留痕、告知风险并亲自承担。",
          "world_and_life": "32岁、维修班长、八年工龄；廉租公寓、步行露天栈桥、盐雾闷潮及狭窄舱道；公用工具登记领用、修理少换；无备用工装。资源条件解释维护选择，不决定美丑、肤色或天生骨架。",
          "relationships": "周遥同薪同能但资源更宽裕，不能把他设计成无能富家子；阿宁接受帮助但林澈拒绝以曝光或感恩绑定她。",
          "arc": "常态原则逐步被看见。初见只显克制、可靠、职业相容；匿名善意和母亲往事不做可见符号。",
          "evidence_unit_ids": [
            "U01",
            "U02",
            "U03",
            "U04",
            "U05"
          ]
        },
        "design_thesis": "先看到一个日常、克制、与维修劳动相容的人；让照护欲留待行动揭露。结构辨识来自脸、眉眼与发块的组合，不用苦相或伤痕替剧情解释。",
        "visual_strategy": "concealed",
        "recommended_direction": "钝圆转折的长方偏椭圆脸，厚上睑与较平直眉，低体积深色短发；普通鼻口、自然肤质、干净自主打理。骨相与肤底均为原创选择。",
        "alternatives": [],
        "delegated_dimensions": [
          "本阶段脸、发、皮肤、主次焦点与头颈表面细节由总控形成一套首稿推荐；均未获用户批准。"
        ],
        "specialist_plan": [
          {
            "specialist": "character-world-appearance-design",
            "mode": "inline",
            "task": {
              "objective": "将实际通勤、舱道作业和维护条件转成外貌机制，并区分创作选择",
              "character_context": "林澈以公开划界掩护不索回报的照护；初见克制可靠，资源有限而维护自尊与设备。",
              "constraints": [
                "真人实拍可行；只深化identity",
                "不得把经济条件推成脸型、肤色或卫生状况",
                "不得新增伤病、特殊血统、宗教标记、义体或剧情遗物",
                "初见不提前揭露隐秘照护动机"
              ],
              "expected_result": "短发维护方案、稳定与临时状态边界；身体衣装只留功能约束"
            }
          },
