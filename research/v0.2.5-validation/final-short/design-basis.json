    "stage-design:identity:CHR-001:base": {
      "sha256": "e6384a2c2b40b3125a288c0df3f8b8e6ae1cd32a77d0c95d0f308fc1ec578139",
      "content": {
        "schema_version": "CharacterStageDesignV1",
        "character_id": "CHR-001",
        "draft_character_id": "DRAFT-LINCHE",
        "variant_id": "base",
        "scope": "identity",
        "parent_refs": {
          "script-context:source-A": "5fb41135529dba381302d9de1670f3db6f94912baacf9bef340922f6b24bb23a",
          "design-brief:CHR-001:base": "ea5da742f3a6dca2ac196867fe958bae2f8be3f55a3db7001a44f67ba6402cf8"
        },
        "payload": {
          "morphology": "32岁成年真人、正常生理形态；不添加技术改造。",
          "appearance": "长方偏椭圆脸、钝圆下颌、厚上睑与平直眉；低短深色发块，普通鼻口与自然整洁肤质。常态放松、不持续皱眉或悲情凝视。",
          "visual_details": {
            "face": {
              "contour": "发际至颏点约为颧部最宽处的1.4倍，长方偏椭圆；额部不窄，颧部不外鼓，下颌宽度约为颧宽八成，转折钝圆，颏部短宽、不收成尖点。以上为创作推荐。",
              "brows_eyes": "深色较平直眉，眉头有密度、眉尾自然变稀；眼裂中等偏长，上睑略厚且褶线浅，眼距约一眼宽，外眼角基本水平；虹膜深棕。常态眉间舒展、不持续蹙眉。",
              "nose": "鼻根中低、鼻梁平直，鼻尖圆钝；鼻翼宽度略超过两内眼角之间的距离。侧面不过度挺拔。",
              "mouth": "口宽中等，上唇薄于下唇，唇峰浅；闭口时唇线近水平，下唇体积可见，嘴角不预设下垂或微笑。",
              "ears": "耳长中等、耳轮贴近头部、耳垂小而游离；无耳饰。",
              "view_notes": "正面读脸宽与眉眼，四分之三读钝圆下颌和圆鼻尖；缩略图优先保留眉眼与低短发块，不锐化每一处。"
